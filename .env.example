# Host postgres user's UID, used by the one-shot migration container so peer
# auth over the mounted socket maps to the postgres role. MUST match the host:
# run `id -u postgres`. 26 is the RHEL/Fedora default; Debian uses 999.
POSTGRES_UID=26

# Where the ecosystem migration runner records applied versions.
# Subscribers: leave unset (ecosystem.schema_migrations).
# Publishers (the hosts whose ecosystem_pub publishes the ecosystem schema): MUST be
#   SCHEMA_MIGRATIONS_TABLE=ecosystem_admin.schema_migrations
# so the tracking table is not itself replicated. migrate.sh refuses to run otherwise.
# SCHEMA_MIGRATIONS_TABLE=ecosystem_admin.schema_migrations
